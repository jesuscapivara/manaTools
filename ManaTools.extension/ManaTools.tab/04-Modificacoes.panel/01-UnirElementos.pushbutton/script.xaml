<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maná SmartJoin V4" Height="450" Width="550" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F0F0F0">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="UNIÃO INTELIGENTE DE CATEGORIAS" FontWeight="Bold" FontSize="16" 
                   Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Label Content="1. Dominante (Corta):" FontWeight="Bold" DockPanel.Dock="Top" Foreground="#27AE60"/>
                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3" Background="White">
                    <ListBox Name="lb_primary" SelectionMode="Extended" Padding="5" BorderThickness="0"/>
                </Border>
            </DockPanel>

            <TextBlock Grid.Column="1" Text="➔" VerticalAlignment="Center" HorizontalAlignment="Center" 
                       FontSize="18" Foreground="#7F8C8D" FontWeight="Bold"/>

            <DockPanel Grid.Column="2">
                <Label Content="2. Submisso (É Cortado):" FontWeight="Bold" DockPanel.Dock="Top" Foreground="#C0392B"/>
                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="3" Background="White">
                    <ListBox Name="lb_secondary" SelectionMode="Extended" Padding="5" BorderThickness="0"/>
                </Border>
            </DockPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Background="White" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <RadioButton Name="rb_join" Content="Unir (Join)" IsChecked="True" Margin="0,0,20,0" FontWeight="SemiBold"/>
                <RadioButton Name="rb_switch" Content="Inverter Ordem (Switch)" Margin="0,0,20,0" FontWeight="SemiBold"
                             ToolTip="Força o Elemento 1 a cortar o Elemento 2"/>
                <RadioButton Name="rb_unjoin" Content="Desunir (Unjoin)" FontWeight="SemiBold" Foreground="Red"/>
            </StackPanel>
        </Border>

        <Button Name="btn_run" Grid.Row="3" Content="EXECUTAR SMART JOIN" Height="45" 
                FontWeight="Bold" FontSize="14" Background="#2C3E50" Foreground="White" 
                BorderThickness="0" Cursor="Hand" Click="button_run_clicked"/>
    </Grid>
</Window>