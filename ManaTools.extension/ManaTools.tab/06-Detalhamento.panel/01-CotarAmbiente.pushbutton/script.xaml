<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maná Cotas" Height="480" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F0F0F0">
    
    <StackPanel Margin="20">
        <TextBlock Text="COTAS AUTOMÁTICAS" FontWeight="Bold" FontSize="18" Foreground="#2C3E50"
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Background="White" Margin="0,0,0,15">
            <StackPanel>
                <Label Content="Estilo de Cota:" FontWeight="SemiBold"/>
                <ComboBox Name="cb_dim_style" Margin="0,0,0,15" Height="25" SelectionChanged="cb_dim_style_changed"/>
                
                <Label Content="Configurações de Distância:" FontWeight="SemiBold"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <Label Content="Dist. da Parede (mm):" ToolTip="Distância da primeira linha em relação à parede (no papel)"/>
                        <TextBox Name="tb_wall_dist" Text="10" Height="25" VerticalContentAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2">
                        <Label Content="Snap (mm):" ToolTip="Se 0, tenta ler do Estilo de Cota"/>
                        <TextBox Name="tb_snap_dist" Text="0" Height="25" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Background="White" Margin="0,0,0,20">
            <StackPanel>
                <Label Content="Camadas de Cota:" FontWeight="SemiBold"/>
                <CheckBox Name="chk_line_1" Content="Linha 1: Detalhe (Aberturas/Bonecas)" IsChecked="False" IsEnabled="False" Margin="0,5,0,0" ToolTip="Em desenvolvimento (V2)"/>
                <CheckBox Name="chk_line_2" Content="Linha 2: Paredes Intersectantes" IsChecked="False" IsEnabled="False" Margin="0,5,0,0" ToolTip="Em desenvolvimento (V2)"/>
                <CheckBox Name="chk_line_3" Content="Linha 3: Total (Ambiente)" IsChecked="True" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <Button Name="btn_run" Content="SELECIONAR AMBIENTES" Height="45" 
                FontWeight="Bold" FontSize="14" Background="#E67E22" Foreground="White" 
                BorderThickness="0" Cursor="Hand" Click="button_run_clicked"/>
    </StackPanel>
</Window>

