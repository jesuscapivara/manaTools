<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maná Cotas V13.0 (Smart Side)" Height="600" Width="420" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F0F0F0">
    
    <StackPanel Margin="20">
        <TextBlock Text="COTAS AUTOMÁTICAS V13" FontWeight="Bold" FontSize="18" Foreground="#2C3E50"
                   Margin="0,0,0,20" HorizontalAlignment="Center"/>

        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Background="White" Margin="0,0,0,15">
            <StackPanel>
                <Label Content="Estilo de Cota:" FontWeight="SemiBold"/>
                <ComboBox Name="cb_dim_style" Margin="0,0,0,15" Height="25" SelectionChanged="cb_dim_style_changed"/>
                
                <Label Content="Lógica de Direção:" FontWeight="SemiBold"/>
                <StackPanel Margin="0,0,0,10">
                    <RadioButton Name="rb_side_ext" Content="Automático (Lado Sem Ambiente)" IsChecked="True" Margin="0,5"
                                 ToolTip="Tenta jogar a cota para fora (onde não há Room)."/>
                    <RadioButton Name="rb_side_int" Content="Forçar Inversão" Margin="0,5"
                                 ToolTip="Inverte a lógica automática."/>
                </StackPanel>

                <StackPanel Grid.Column="0">
                    <Label Content="Afastamento (mm):" ToolTip="Distância entre linhas."/>
                    <TextBox Name="tb_dist" Text="10" Height="25" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="5" Padding="10" Background="White" Margin="0,0,0,20">
            <StackPanel>
                <Label Content="Hierarquia de Linhas:" FontWeight="SemiBold"/>
                <CheckBox Name="chk_line_1" Content="1. Detalhada (Aberturas + Paredes)" IsChecked="True" Margin="0,5"/>
                <CheckBox Name="chk_line_2" Content="2. Paredes (Apenas Alvenaria)" IsChecked="True" Margin="0,5"/>
                <CheckBox Name="chk_line_3" Content="3. Total (Comprimento)" IsChecked="True" Margin="0,5"/>
            </StackPanel>
        </Border>
        
        <Button Name="btn_run" Content="COTAR PAREDES" Height="45" 
                FontWeight="Bold" FontSize="14" Background="#2980B9" Foreground="White" 
                BorderThickness="0" Cursor="Hand" Click="button_run_clicked"/>
    </StackPanel>
</Window>