<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maná Detalhador" Height="500" Width="350" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F0F0F0">
    <StackPanel Margin="15">
        <TextBlock Text="DETALHAR VISTAS" FontWeight="Bold" FontSize="16" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,5"/>
        
        <TextBlock Text="Auto-Detecção de contexto (Vista Ativa ou Seleção)" FontStyle="Italic" Foreground="Gray" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <GroupBox Header="Tags" Padding="5" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox Name="chk_room" Content="Tag de Ambiente (1.60m)" IsChecked="True" FontWeight="Bold" Margin="0,5"/>
                <ComboBox Name="cb_room" Height="25" Margin="20,0,0,10"/>
                
                <CheckBox Name="chk_tags" Content="Esquadrias" IsChecked="True" FontWeight="Bold" Margin="0,5"/>
                <Grid Margin="20,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="30"/></Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Porta:" VerticalAlignment="Center"/>
                    <ComboBox Name="cb_door" Grid.Row="0" Grid.Column="1" Height="25"/>
                    <Label Grid.Row="1" Content="Janela:" VerticalAlignment="Center"/>
                    <ComboBox Name="cb_win" Grid.Row="1" Grid.Column="1" Height="25"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Cotas" Padding="5">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <CheckBox Name="chk_dim_h" Grid.Column="0" Content="Horizontal" IsChecked="True" FontWeight="Bold"/>
                    <CheckBox Name="chk_dim_v" Grid.Column="1" Content="Vertical" IsChecked="True" FontWeight="Bold"/>
                </Grid>
                <Label Content="Estilo de Cota:" Margin="0,5,0,0"/>
                <ComboBox Name="cb_dim" Height="25"/>
            </StackPanel>
        </GroupBox>

        <Button Content="DETALHAR" Height="40" Margin="0,15,0,0" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="btn_run_click"/>
    </StackPanel>
</Window>