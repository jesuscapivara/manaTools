<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maná Gerador V6" Height="550" Width="350" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F0F0F0">
    <StackPanel Margin="15">
        <TextBlock Text="GERAR ELEVAÇÕES" FontWeight="Bold" FontSize="16" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>
        
        <GroupBox Header="Direções" Padding="5" Margin="0,0,0,10">
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                <ToggleButton Name="tg_n" Grid.Row="0" Grid.Column="1" Content="N" FontWeight="Bold" IsChecked="True"/>
                <ToggleButton Name="tg_o" Grid.Row="1" Grid.Column="0" Content="O" FontWeight="Bold" IsChecked="True"/>
                <ToggleButton Name="tg_l" Grid.Row="1" Grid.Column="2" Content="L" FontWeight="Bold" IsChecked="True"/>
                <ToggleButton Name="tg_s" Grid.Row="2" Grid.Column="1" Content="S" FontWeight="Bold" IsChecked="True"/>
            </Grid>
        </GroupBox>

        <Label Content="Template de Vista:" FontWeight="SemiBold"/>
        <ComboBox Name="cb_view_templates" Height="25" Margin="0,0,0,10"/>

        <Label Content="Offsets (cm):" FontWeight="SemiBold"/>
        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0"><Label Content="Topo:" FontSize="10"/><TextBox Name="tb_top" Height="25"/></StackPanel>
            <StackPanel Grid.Column="2"><Label Content="Base:" FontSize="10"/><TextBox Name="tb_bot" Height="25"/></StackPanel>
        </Grid>
        
        <CheckBox Name="chk_wall" Content="Incluir Espessura Parede" IsChecked="True" Margin="0,5"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
            <Label Content="Extra Lateral (cm):" FontSize="10" VerticalAlignment="Center"/>
            <TextBox Name="tb_side" Width="50" Height="25" Margin="5,0,0,0"/>
        </StackPanel>

        <Button Content="CRIAR VISTAS" Height="40" Background="#2980B9" Foreground="White" FontWeight="Bold" Click="btn_ok_click"/>
    </StackPanel>
</Window>